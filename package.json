{
	"name": "LibreRiichi",
	"version": "1.0.0",
	"description": "Open Source Mahjong Server",
	"repository": "git@codeberg.org:ijnakashiar/LibreRiichi.git",
	"browserslist": "> 0.5%, last 2 versions, not dead",
	"author": "IJN Akashi AR <dabanya@protonmail.com>",
	"license": "MIT",
	"devDependencies": {
		"@babel/cli": "^7.28.0",
		"@parcel/transformer-vue": "^2.15.4",
		"@types/three": "^0.180.0",
		"assert": "^2.1.0",
		"buffer": "^5.5.0||^6.0.0",
		"concurrently": "^9.1.2",
		"console-browserify": "^1.2.0",
		"parcel": "^2.15.4",
		"prettier": "^3.6.2",
		"process": "^0.11.10",
		"typescript": "^5.8.3",
		"util": "^0.12.5"
	},
	"scripts": {
		"frontend": "parcel app/index.html",
		"build-frontend": "parcel build app/index.html",
		"watch-backend": "air --build.cmd \"go build -o build/server cmd/server/main.go\" --build.entrypoint \"./build/server\"",
		"backend": "go run cmd/server/main.go",
		"build-backend": "go build -o dist-server/server cmd/server/main.go",
		"watch": "concurrently -k \"yarn:frontend\" \"yarn:watch-backend\"",
		"test-client": "go run cmd/eval_client/eval_client.go",
		"test": "concurrently -k \"yarn:test-client\" \"yarn:backend\"",
		"lint": "prettier --write 'app/**/*.{js,ts,vue}'"
	},
	"dependencies": {
		"@babel/core": "^7.28.0",
		"@babel/polyfill": "^7.12.1",
		"@babel/preset-env": "^7.28.0",
		"@parcel/babel-preset-env": "^2.15.4",
		"@tailwindcss/postcss": "^4.1.10",
		"autoprefixer": "^10.4.21",
		"google-closure-compiler": "^20250615.0.0",
		"pinia": "^3.0.3",
		"tailwindcss": "^4.1.10",
		"three": "^0.180.0",
		"typescript-json-schema": "^0.65.1",
		"uuid": "^11.1.0",
		"vue": "^3.5.16",
		"vue-router": "4"
	},
	"targets": {
		"default": {
			"engines": {
				"browsers": "> 0.5%, not dead",
				"node": ">=20"
			},
			"context": "browser",
			"includeNodeModules": true
		}
	}
}
